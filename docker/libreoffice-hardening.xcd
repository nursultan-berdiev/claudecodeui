<?xml version="1.0" encoding="UTF-8"?>
<!-- Installed into /usr/lib/libreoffice/share/registry/ by the Dockerfile. Agents convert
     untrusted .doc/.xls with soffice; macros in those files must never run. The values are
     finalized, so a user profile (each conversion uses a throwaway one) cannot relax them. -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:name="Common" oor:package="org.openoffice.Office">
    <node oor:name="Security">
      <node oor:name="Scripting">
        <prop oor:name="DisableMacrosExecution" oor:finalized="true">
          <value>true</value>
        </prop>
        <prop oor:name="MacroSecurityLevel" oor:finalized="true">
          <value>3</value>
        </prop>
      </node>
    </node>
  </oor:component-data>
</oor:data>
